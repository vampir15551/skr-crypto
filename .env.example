# =============================================================================
# USDT TRC-20 Payout Service — Configuration
# Copy to .env and fill in values
# =============================================================================

# --- Auth ---
AUTH_TOKEN=                   # Required. API key for X-API-Key header

# --- Key provider ---
# Where the service loads private keys from. Five backends:
#   1password      — 1Password CLI (op). Operator-on-laptop only.
#   env            — PRIVATE_KEY_HEX env var. Container/CI friendly.
#   file           — chmod-600 file at PRIVATE_KEY_FILE. VPS/systemd.
#   keychain       — macOS Keychain. Local dev on a Mac.
#   encrypted_file — AES-256-GCM JSON keystore at KEYSTORE_FILE.
#                    Multi-wallet by construction, container-safe.
KEY_PROVIDER=1password

# Multi-wallet listing. Empty = single wallet (legacy, uses globals below).
# Otherwise, comma-separated list of wallet names. Each provider then expects
# per-wallet env vars (see server/key_providers.py for the naming rules).
# `encrypted_file` ignores this — its file is the source of truth.
# Examples:
#   WALLETS=main,reserve
#   WALLETS=hot,cold,treasury
WALLETS=

# --- 1Password backend (single-wallet legacy) ---
OP_VAULT=Treasury
OP_ITEM=TRON-Treasury-TXpdZ6qv
OP_FIELD=password
# Multi-wallet: WALLET_<NAME>_OP_ITEM=<item-name> for each name in WALLETS.

# --- File backend (single-wallet legacy) ---
PRIVATE_KEY_FILE=
# Multi-wallet: WALLET_<NAME>_PRIVATE_KEY_FILE=<path> for each name in WALLETS.

# --- macOS Keychain backend (single-wallet legacy) ---
KEYCHAIN_SERVICE=skr-crypto
KEYCHAIN_ACCOUNT=treasury
# Multi-wallet: WALLET_<NAME>_KEYCHAIN_ACCOUNT=<account>; service stays shared.

# --- Encrypted file backend (multi-wallet, container-safe) ---
# KEYSTORE_FILE: path to the AES-256-GCM keystore JSON. Created by
#                `skr-crypto wallet encrypt`. Holds N wallets behind one
#                passphrase; chmod 600.
# KEY_PASSPHRASE: env var with the unlock passphrase. Consumed and
#                 removed from the process environment after first use.
# KEY_PASSPHRASE_FILE: alternative chmod-600 file with the passphrase
#                     (used when you don't want it visible in `ps`/inspect).
# If neither is set and stdin is a TTY, the service prompts on start.
KEYSTORE_FILE=
KEY_PASSPHRASE=
KEY_PASSPHRASE_FILE=

# --- TRON Network ---
TRON_NETWORK=mainnet          # mainnet | shasta | nile
TRONGRID_API_KEY=             # Optional but recommended (avoids 429s)
USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_FEE_LIMIT_SUN=30000000   # Per-tx fee_limit cap in SUN (30 TRX). fee_limit is a CEILING, not what you pay — actual cost is energy_used × price.
MIN_TRX_RESERVE=50            # Min TRX balance required before broadcasting; must be >= USDT_FEE_LIMIT_SUN/1_000_000
TRON_HTTP_TIMEOUT=15          # Timeout for every TronGrid RPC call (seconds)

# --- Cost controls ---
TRON_ENERGY_PRICE_SUN_FALLBACK=420   # Fallback if we can't read chain param getEnergyFee. Proposal-controlled, historical 100–420.
MAX_ENERGY_BURN_TRX=20               # Hard ceiling on per-tx energy burn. If estimate exceeds this, request returns 400 ENERGY_TOO_EXPENSIVE. Stake TRX or rent energy instead. Set 0 to disable.
FEE_LIMIT_SAFETY_MULT=1.3            # Multiplier applied to the energy estimate when picking fee_limit. >=1.0.

# --- Recipient risk preflight (added in 1.2.0; expanded in 1.3.0) ---
RISK_BLOCK_LEVEL=high                # high (default) | medium | none. Controls when /send refuses on the wallet-risk verdict.
RISK_USE_EXTERNAL=true               # Default ON since 1.3.0. /send preflight calls TronScan + MistTrack-if-keyed. ~+300ms per /send. Set false to use TronGrid-only.

# --- OFAC SDN sanctions (always-on, no rate limit) ---
SANCTIONS_LIST_URL=https://raw.githubusercontent.com/0xB10C/ofac-sanctioned-digital-currency-addresses/lists/sanctioned_addresses_TRX.txt
SANCTIONS_LIST_REFRESH=true          # On startup, fetch latest list. false = use on-disk cache only (offline / air-gapped).

# --- MistTrack (SlowMist) AML — opt-in ---
MISTTRACK_API_KEY=                   # If set, /send preflight + `skr-crypto risk --external` query MistTrack /v1/risk_score. Free tier ~100/day. Without a key the check cleanly SKIPs.

# --- Audit durability ---
AUDIT_LOG_FILE=               # Path to append-only audit file with fsync per record. Empty = stdout-only (NOT durable).

# --- Idempotency persistence ---
IDEMPOTENCY_DB_PATH=          # Path to SQLite file. Empty = in-memory (state lost on restart). Orphaned PENDING rows from crashed prior runs get promoted to UNKNOWN, causing retries to fail with IDEMPOTENCY_UNRESOLVED.

# --- Server ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SHUTDOWN_TIMEOUT=600          # Auto-shutdown after N seconds of inactivity

# --- Rate Limiting ---
RATE_LIMIT_MAX=30             # Max requests per window per IP
RATE_LIMIT_WINDOW=60          # Window size in seconds
TRUSTED_PROXIES=              # Comma-separated IPs; request-peer IPs in this list make us read X-Forwarded-For. Empty = never trust XFF (safe default).
