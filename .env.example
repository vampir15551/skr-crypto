# =============================================================================
# USDT TRC-20 Payout Service — Configuration
# Copy to .env and fill in values
# =============================================================================

# --- Auth ---
AUTH_TOKEN=                   # Required. API key for X-API-Key header

# --- 1Password (private key source) ---
OP_VAULT=Treasury
OP_ITEM=TRON-Treasury-TXpdZ6qv
OP_FIELD=password

# --- TRON Network ---
TRON_NETWORK=mainnet          # mainnet | shasta | nile
TRONGRID_API_KEY=             # Optional but recommended (avoids 429s)
USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_FEE_LIMIT_SUN=30000000   # Per-tx fee_limit cap in SUN (30 TRX). fee_limit is a CEILING, not what you pay — actual cost is energy_used × price.
MIN_TRX_RESERVE=50            # Min TRX balance required before broadcasting; must be >= USDT_FEE_LIMIT_SUN/1_000_000
TRON_HTTP_TIMEOUT=15          # Timeout for every TronGrid RPC call (seconds)

# --- Cost controls ---
TRON_ENERGY_PRICE_SUN_FALLBACK=420   # Fallback if we can't read chain param getEnergyFee. Proposal-controlled, historical 100–420.
MAX_ENERGY_BURN_TRX=20               # Hard ceiling on per-tx energy burn. If estimate exceeds this, request returns 400 ENERGY_TOO_EXPENSIVE. Stake TRX or rent energy instead. Set 0 to disable.
FEE_LIMIT_SAFETY_MULT=1.3            # Multiplier applied to the energy estimate when picking fee_limit. >=1.0.

# --- Recipient risk preflight (added in 1.2.0) ---
RISK_BLOCK_LEVEL=high                # high (default) | medium | none. Controls when /send refuses on the wallet-risk verdict. Same logic as `skr-crypto risk <addr>`.
RISK_USE_EXTERNAL=false              # If true, /send preflight (and `skr-crypto risk` when run server-side) also queries TronScan reputation. +300ms per /send. CLI's --external flag is independent of this.

# --- Audit durability ---
AUDIT_LOG_FILE=               # Path to append-only audit file with fsync per record. Empty = stdout-only (NOT durable).

# --- Idempotency persistence ---
IDEMPOTENCY_DB_PATH=          # Path to SQLite file. Empty = in-memory (state lost on restart). Orphaned PENDING rows from crashed prior runs get promoted to UNKNOWN, causing retries to fail with IDEMPOTENCY_UNRESOLVED.

# --- Server ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SHUTDOWN_TIMEOUT=600          # Auto-shutdown after N seconds of inactivity

# --- Rate Limiting ---
RATE_LIMIT_MAX=30             # Max requests per window per IP
RATE_LIMIT_WINDOW=60          # Window size in seconds
TRUSTED_PROXIES=              # Comma-separated IPs; request-peer IPs in this list make us read X-Forwarded-For. Empty = never trust XFF (safe default).
